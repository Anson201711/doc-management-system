<?xml version='1.1' encoding='UTF-8'?>
<project>
  <description>Build and deploy API Gateway service</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <jenkins.build.concurrent.allowFalseConcurrent>true</jenkins.build.concurrent.allowFalseConcurrent>
  </properties>
  <scm class="hudson.scm.NullSCM"/>
  <canRoam>true</canRoam>
  <disabled>false</disabled>
  <blockBuildWhenDownstreamBuilding>false</blockBuildWhenDownstreamBuilding>
  <blockBuildWhenUpstreamBuilding>false</blockBuildWhenUpstreamBuilding>
  <triggers/>
  <concurrentBuild>false</concurrentBuild>
  <builders>
    <hudson.tasks.Shell>
      <command>#!/bin/bash
set -e
cd /var/jenkins_home/workspace/backend-build
mvn clean package -pl api-gateway -am -DskipTests</command>
      <configuredLocalRules/>
    </hudson.tasks.Shell>
  </builders>
  <publishers/>
  <buildWrappers/>
</project>